[Unit]
Description=Ulovko rootless BuildKit
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ctf-builder
Group=ulovko-build
UMask=0007
Environment=HOME=/var/lib/ctf-builder
Environment=XDG_RUNTIME_DIR=/run/ulovko-buildkit/private
RuntimeDirectory=ulovko-buildkit
RuntimeDirectoryMode=0770
StateDirectory=ulovko-buildkit
StateDirectoryMode=0700
ExecStartPre=/usr/bin/install -d -m 0700 /run/ulovko-buildkit/private
ExecStart=/usr/bin/rootlesskit --net=slirp4netns --copy-up=/etc --disable-host-loopback buildkitd --config /etc/buildkit/ulovko-rootless.toml --addr unix:///run/ulovko-buildkit/buildkitd.sock --root /var/lib/ulovko-buildkit --oci-worker-snapshotter=native
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
