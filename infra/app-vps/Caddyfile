ulovko.fun {
    root * /opt/ctf/frontend/dist
    encode zstd gzip

    # NestJS API; preserve the /api prefix.
    @api path /api /api/*
    handle @api {
        reverse_proxy 127.0.0.1:3000
    }

    # Missing built assets should return 404 instead of SPA HTML.
    @assets path /assets/*
    handle @assets {
        file_server
    }

    # React SPA with TanStack Router.
    handle {
        try_files {path} /index.html
        file_server
    }
}

# Optional: redirect the old API domain to the canonical origin.
api.ulovko.fun {
    redir https://ulovko.fun{uri} 308
}
