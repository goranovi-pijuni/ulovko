    "/api/flag-submission": {
      "post": {
        "operationId": "FlagSubmissionController_submit",
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SubmitFlagDto"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Rezultat provjere: correct, incorrect ili already_solved (tim je već riješio zadatak)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SubmissionResponseDto"
                }
              }
            }
          },
          "400": {
            "description": "Neispravno tijelo zahtjeva"
          },
          "401": {
            "description": "Korisnik nije prijavljen"
          },
          "403": {
            "description": "Natjecanje nije aktivno ili korisnik nije član tima"
          },
          "404": {
            "description": "Zadatak nije pronađen ili nije objavljen"
          },
          "429": {
            "description": "Previše pokušaja za ovaj zadatak"
          }
        },
        "security": [
          {
            "session": []
          }
        ],
        "summary": "Predaja zastavice za zadatak",
        "tags": [
          "FlagSubmission"
        ]
      }
    },
